# คัดลอกเป็น apps/api/.env แล้วแก้ค่า — ห้าม commit .env
# ค่าด้านล่างเป็นค่า local dev ของ docker-compose.yml เท่านั้น (ไม่ใช่ secret จริง)

NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error
LOG_LEVEL=info

# Postgres (local: pnpm db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_crm

# DB ของ automated tests — ชื่อต้องลงท้ายด้วย _test เพราะ test จะล้างข้อมูลทุกครั้ง
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_crm_test

# ---- Auth ----
# secret สำหรับเซ็น session JWT (อย่างน้อย 32 ตัวอักษร) — สร้างด้วย: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# อายุ session (ชั่วโมง)
SESSION_TTL_HOURS=8
# จำนวน proxy หน้า API สำหรับหา IP จริงของผู้ใช้ (local ผ่าน Next = 1, Railway ผ่าน edge + Next = 2)
TRUST_PROXY=1

# ---- AI (skills/crm-copilot) ----
# เว้นว่าง = ใช้กติกาสำรอง (ระบบยังใช้งานได้ครบ) — key จริงใส่ใน .env หรือ Railway Variables เท่านั้น
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# low | medium | high — ลึกขึ้น = ตอบช้าลง
AI_EFFORT=medium
# เกินเวลานี้ใช้กติกาสำรองแทน (ms)
AI_TIMEOUT_MS=25000

# ---- LINE ----
# mock = ไม่ส่งจริง (จำลองในหน่วยความจำ) — Phase 5 เพิ่ม live
LINE_MODE=mock

# รหัสผ่านของบัญชี demo ทุกบัญชีที่ seed สร้าง (อย่างน้อย 12 ตัวอักษร)
SEED_DEMO_PASSWORD=change-me-to-a-demo-password
